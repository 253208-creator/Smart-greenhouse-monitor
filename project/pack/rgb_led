from machine import Pin


class RGBLed:
    """Driver class for a 4-pin common-cathode RGB LED module."""

    def __init__(self, r_pin, g_pin, b_pin):
        self.r = Pin(r_pin, Pin.OUT)
        self.g = Pin(g_pin, Pin.OUT)
        self.b = Pin(b_pin, Pin.OUT)
        self.off()

    def set_color(self, r, g, b):
        self.r.value(1 if r else 0)
        self.g.value(1 if g else 0)
        self.b.value(1 if b else 0)

    def off(self):
        self.set_color(0, 0, 0)

    def update_ventilation_status(self, is_ventilating):
        """Set green when ventilating, red otherwise."""
        if is_ventilating:
            self.set_color(0, 1, 0)  # Zelená = větrá
        else:
            self.set_color(1, 0, 0)  # Červená = nevětrás
